<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <AssemblyName>MuteMe</AssemblyName>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net9.0-windows</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <ApplicationManifest>app.manifest</ApplicationManifest>

        <!-- Native AOT: implica SelfContained + trimming, non serve ripeterli -->
        <PublishAot>true</PublishAot>
        <RuntimeIdentifier>win-x64</RuntimeIdentifier>
        <!-- Richiesto dal codice generato da LibraryImport / GeneratedComInterface -->
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

        <!-- Rimuove simboli di debug e dati inutili -->
        <DebugType>none</DebugType>
        <DebugSymbols>false</DebugSymbols>

        <!-- Rimuove dati di localizzazione (Date/Valute estere) - Risparmia ~3MB -->
        <InvariantGlobalization>true</InvariantGlobalization>

        <!-- App da tray, ferma il 99% del tempo: il background GC e un thread
             e un heap committed che non usiamo mai -->
        <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>

        <!-- Avalonia Config -->
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    </PropertyGroup>

    <ItemGroup>
        <!-- Avalonia.Desktop tira dentro Avalonia come dipendenza transitiva -->
        <PackageReference Include="Avalonia.Desktop" Version="11.2.1"/>
        <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.1"/>

        <!-- NOTA: HO RIMOSSO "Avalonia.Fonts.Inter".
             Questo pacchetto pesa 2.5 MB. Avalonia userà il font di sistema (Segoe UI). -->

        <!-- Diagnostica solo in Debug -->
        <PackageReference Include="Avalonia.Diagnostics" Version="11.2.1" Condition="'$(Configuration)' == 'Debug'" />
    </ItemGroup>

    <ItemGroup>
        <AvaloniaResource Include="Assets\**" />
    </ItemGroup>
</Project>
